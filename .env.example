# Google Gemini API key. If left empty, the system automatically falls back to
# local rule-based / keyword logic for chat parsing and RAG retrieval, so the
# app still runs fully offline for demo purposes.
GEMINI_API_KEY=

# SQLite database file path
DATABASE_PATH=data/triage.db

# Host / port the server binds to
HOST=0.0.0.0
PORT=8000
